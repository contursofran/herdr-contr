{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "herdr-contr-agents"
              }
            }
          ]
        },
        {
          "id": "usage",
          "type": "block",
          "size": {
            "px": 56
          },
          "hidden": true,
          "content": {
            "mod": "herdr-contr",
            "props": {
              "view": "usage"
            }
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "herdr-contr-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "screen",
              "type": "stack",
              "active": "chat",
              "children": [
                {
                  "id": "chat",
                  "type": "block",
                  "content": {
                    "mod": "herdr-contr",
                    "props": {
                      "view": "chat"
                    }
                  },
                  "window_drag": true
                },
                {
                  "id": "needs",
                  "type": "block",
                  "content": {
                    "mod": "herdr-contr",
                    "props": {
                      "view": "needs"
                    }
                  },
                  "window_drag": true
                },
                {
                  "id": "overview",
                  "type": "block",
                  "content": {
                    "mod": "herdr-contr",
                    "props": {
                      "view": "overview"
                    }
                  },
                  "window_drag": true
                },
                {
                  "id": "tab",
                  "type": "column",
                  "children": [
                    {
                      "id": "view-switch",
                      "type": "block",
                      "size": {
                        "px": 36
                      },
                      "content": {
                        "mod": "herdr-contr",
                        "props": {
                          "view": "switch"
                        }
                      }
                    },
                    {
                      "id": "tab-panes",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "gap": 6,
                          "radius": 8,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 1,
                            "color": "muted"
                          }
                        }
                      },
                      "padding": 8
                    }
                  ]
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "light": "herdr-contr-light",
    "dark": "herdr-contr"
  },
  "divider": {
    "width": 1,
    "color": "border"
  }
}
