{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "screen",
          "type": "stack",
          "active": "chat",
          "children": [
            {
              "id": "chat",
              "type": "block",
              "content": {
                "mod": "flockbook",
                "props": {
                  "view": "chat"
                }
              },
              "window_drag": true
            },
            {
              "id": "needs",
              "type": "block",
              "content": {
                "mod": "flockbook",
                "props": {
                  "view": "needs"
                }
              },
              "window_drag": true
            },
            {
              "id": "overview",
              "type": "block",
              "content": {
                "mod": "flockbook",
                "props": {
                  "view": "overview"
                }
              },
              "window_drag": true
            },
            {
              "id": "tab",
              "type": "column",
              "children": [
                {
                  "id": "top",
                  "type": "block",
                  "size": {
                    "px": 56
                  },
                  "window_drag": true,
                  "content": {
                    "mod": "flockbook",
                    "props": {
                      "view": "top"
                    }
                  }
                },
                {
                  "id": "tab-panes",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 6,
                      "radius": 8,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "muted"
                      }
                    }
                  },
                  "padding": 8
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "light": "flockbook-light",
    "dark": "flockbook"
  },
  "divider": {
    "width": 1,
    "color": "border"
  }
}
